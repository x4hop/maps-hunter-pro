{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "maps-hunter-pro-preview",
  "main": "./preview-worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "../dist/frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "maps-hunter-pro-api"
    }
  ],
  "observability": {
    "enabled": true
  }
}
