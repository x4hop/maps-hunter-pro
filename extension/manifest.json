{
  "manifest_version": 3,
  "name": "Maps Hunter Pro",
  "version": "8.2.6",
  "description": "Instant Google Maps result capture with direct extraction and professional export.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://maps.google.com/*",
    "https://maps-hunter-pro-api.anas98gha.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Maps Hunter Pro"
  },
  "side_panel": {
    "default_path": "panel-v2.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
